# Supabase（プロジェクト設定 > API から取得）
NEXT_PUBLIC_SUPABASE_URL=
# anonキーはログイン（マジックリンク）のセッション管理にのみ使う。
# データの読み書きはSUPABASE_SERVICE_ROLE_KEYを使うサーバー側コードのみが行う（RLSはブラウザから直接アクセスさせない設定）。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# このボットのslug（supabase/migrations/0002_seed.sql と合わせる）
BOT_SLUG=osaka-sekizai

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# 円換算の利用状況見積もり用（Anthropicの料金ページの最新値を確認して設定してください。既定値は目安）
ANTHROPIC_INPUT_PRICE_PER_MTOK_USD=1
ANTHROPIC_OUTPUT_PRICE_PER_MTOK_USD=5
USD_TO_JPY_RATE=155

# Voyage AI（埋め込み。日本語を含む多言語対応モデルを既定にしている）
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-multilingual-2

# 埋め込みウィジェットの利用を許可するドメイン（カンマ区切り、末尾スラッシュなし）
ALLOWED_WIDGET_ORIGINS=https://www.osaka-sekizai.jp,http://localhost:3000

# レート制限（IPごと）
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100

# 管理画面のURL（Supabase Authのマジックリンクのリダイレクト先に使う）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
